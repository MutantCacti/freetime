# Copy to .secrets (gitignored) for ./ft deploy. Never commit .secrets.
# Production secrets, one section per Worker. Each line is NAME=value; the value is
# the rest of the line. ./ft deploy sends them to Cloudflare with each Worker's deploy.
# See DEV-SPEC.md §6. To set one interactively: ./ft secrets --set NAME

[site]
# One or more secret iCal addresses, separated by spaces (at most 10).
ICAL_URL=

[accounts]
# A Resend API key with sending access only.
RESEND_API_KEY=
# Key material for calendar addresses stored in D1. Make it with
# ./ft secrets --generate ACCOUNTS_KEY, and never change it once deployed.
ACCOUNTS_KEY=
