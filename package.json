{
  "name": "freetime-mutantcacti",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "dev:live": "wrangler dev",
    "dev:accounts": "wrangler d1 migrations apply freetime-accounts-dev --local -c wrangler.accounts.toml --env dev && wrangler dev -c wrangler.accounts.toml --env dev --port 8788",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ft": "node scripts/ft.mjs"
  },
  "dependencies": {
    "hono": "4.13.14",
    "ical.js": "2.2.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.9",
    "@cloudflare/workers-types": "5.20261028.1",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.154.0"
  }
}
